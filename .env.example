# Copy to .env and replace every CHANGEME value. Do not commit .env.
# Read at startup by `uv run` and by docker compose alike; a variable already
# exported in the shell wins over this file.
# Generate secrets, for example: openssl rand -hex 32

# Enable Banking credentials live in accounts.json, not here. The private key
# is mounted from ./private.pem by docker-compose.yaml.

# Optional overrides for the amonhen service.
AMONHEN_SYNC_INTERVAL_HOURS=6
# Which published image the container runs: a version tag is what a deploy
# pins, and `latest` is what a first run uses. CI publishes both.
# AMONHEN_TAG=v1.3.0
# AMONHEN_DB_PATH=/data/amonhen.db
# AMONHEN_CONFIG_FILE=/config/accounts.json
# Where docker-compose publishes the API on the host. 127.0.0.1 keeps it on the
# host and leaves Tailscale to reach it; widen it only if something else already
# terminates access. This is the host side: inside the container the app listens
# on 0.0.0.0, which is what AMONHEN_HOST means.
# AMONHEN_BIND_ADDRESS=127.0.0.1

# The optional model that proposes a category for merchants no rule covers.
# AMONHEN_LLM_URL is the *whole* endpoint: the client posts to it as it is, with
# no path appended. Any OpenAI-compatible chat completions gateway works.
AMONHEN_LLM_URL=https://api.deepseek.com/chat/completions
AMONHEN_LLM_MODEL=deepseek-v4-flash
AMONHEN_LLM_API_KEY=CHANGEME

# Existing Actual Budget server: only needed for the optional actual-mcp profile.
# Actual Budget is not a dependency of AmonHen.
ACTUAL_HOSTNAME=actual.example.ts.net
ACTUAL_URL=https://actual.example.ts.net:5006
ACTUAL_PASSWORD=CHANGEME
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_BUDGET_SYNC_ID=CHANGEME
ACTUAL_MCP_TOKEN=CHANGEME
